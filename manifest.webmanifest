{
  "name": "AppArq — Lecteur Markdown",
  "short_name": "AppArq",
  "description": "Lecteur de fichiers Markdown (.md) qui fonctionne hors connexion.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "id": "./",
  "display": "standalone",
  "background_color": "#0d0b12",
  "theme_color": "#121019",
  "categories": [
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "file",
          "accept": [
            "text/markdown",
            "text/x-markdown",
            "text/plain",
            "application/epub+zip",
            "application/pdf",
            "application/octet-stream",
            ".md",
            ".markdown",
            ".mdown",
            ".mkd",
            ".txt",
            ".epub",
            ".pdf"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "text/markdown": [
          ".md",
          ".markdown",
          ".mdown",
          ".mkd"
        ],
        "application/epub+zip": [
          ".epub"
        ],
        "application/pdf": [
          ".pdf"
        ],
        "text/plain": [
          ".txt"
        ]
      }
    }
  ]
}
